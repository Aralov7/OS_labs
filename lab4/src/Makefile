# Все цели по умолчанию
all: libImpl1.so libImpl2.so test_static test_dynamic

# Сборка динамической библиотеки для lib1
libImpl1.so: math_lib1.o gcd_evclid.o
	gcc -shared -o $@ $^ -lm
# -shared указывает, что создаем динам библу 
# (shared object), а не исполняемый файл.
# -o задает имя файла
# $@ — автоматическая переменная, 
# которая заменяется на имя цели (т.е. libImpl1.so).
# $^ - автоматическая переменная, 
# которая заменяется на список всех зависимостей (т.е. prime_naive.o gcd_evclid.o).
# -lm - математичекая библиотека libm.so

# Сборка динамической библиотеки для lib2
libImpl2.so: math_lib2.o gcd_naive.o
	gcc -shared -o $@ $^ -lm

# Компиляция первой библиотеки
math_lib1.o: math_lib1.c
	gcc -fPIC -Wall -Wextra -c $< -o $@
# -fPIC - Position-Independent Code — генерирует позиционно-независимый код
# для файлов, используемых в динамических библиотеках
# -Wall включает все основные предупреждения компилятора
# -Wextra включает дополнительные предупреждения, не покрытые -Wall
# -c чтобы компиллятор остановился после создания объектника и не выполнял линковку
# $< подставляет имя первой зависимости из списка (prime_naive.c)


gcd_evclid.o: gcd_evclid.c
	gcc -fPIC -Wall -Wextra -c $< -o $@

# Компиляция второй библиотеки
math_lib2.o: math_lib2.c
	gcc -fPIC -Wall -Wextra -c $< -o $@

gcd_naive.o: gcd_naive.c
	gcc -fPIC -Wall -Wextra -c $< -o $@

# Сборка тестовой программы №1 (статическое использование библиотек)
test_static: test_static.c
	gcc -o $@ $< -L. -lImpl1 -lm -Wl,-rpath,.
# -L. говорит линкеру искать библиотеки в текущей директории
# -lImpl1 подключает библиотеку libImpl1.so
# -Wl передает опции линкеру через компилятор.
#  -rpath,. указывает линкеру добавить текущую директорию (.) 
# в список путей для поиска  библиотек во время выполнения

# Сборка тестовой программы №2 (динамическая загрузка библиотек)
test_dynamic: test_dynamic.c
	gcc -o $@ $< -ldl
	
# -ldl Подключает библиотеку libdl.so (Dynamic Linking Library), 
# которая предоставляет функции для динамической загрузки других библиотек в runtime.

# Очистка сгенерированных файлов
clean:
	rm -f *.o *.so test_static test_dynamic

# Указание целей, которые не являются файлами
.PHONY: all clean